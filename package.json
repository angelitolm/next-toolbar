{
  "name": "next-toolbar-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @angelitolm/next-toolbar build",
    "test": "pnpm --filter @angelitolm/next-toolbar test",
    "pack": "pnpm build && pnpm --filter @angelitolm/next-toolbar pack --pack-destination ../../.tarballs"
  },
